# ─────────────────────────────────────────────
# Miri 環境変数テンプレート
# このファイルをコピーして .env.local を作成し、値を埋めてください
# ─────────────────────────────────────────────

# 環境識別子 (development | production)
# development = ダミーデータ表示あり（開発・テスト用）
# production  = 本番・ダミーデータなし
NEXT_PUBLIC_APP_ENV=development

# Supabase
# https://supabase.com のプロジェクト設定 > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── 決済（Stripe）※サーバー専用。クライアントには公開しない ──
# Supabase の service role key（RLSを迂回してWebhookからコイン付与に使う。絶対に公開しない）
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Stripe シークレットキー（テストは sk_test_ で始まる値 / 本番は sk_live_ で始まる値）
STRIPE_SECRET_KEY=（Stripeダッシュボードで取得したシークレットキーをここに）
# Stripe Webhook 署名シークレット（エンドポイント登録で取得。whsec_ で始まる値）
STRIPE_WEBHOOK_SECRET=（Stripeダッシュボードで取得したWebhook署名シークレットをここに）
# 購入ボタンを有効化するフラグ（1で有効／未設定なら「準備中」表示で無効）
NEXT_PUBLIC_STRIPE_ENABLED=0
# サイトの公開URL（決済の戻り先などに使用。独自ドメイン公開時に設定）
NEXT_PUBLIC_SITE_URL=https://miriapp.vercel.app

# ── Cloudflare Turnstile（ボット対策・無料）──
# Cloudflare ダッシュボード → Turnstile でウィジェットを作成して取得
# サイトキー（公開してよい）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=（Cloudflare Turnstile のサイトキーをここに）
# シークレットキー（サーバー専用・公開しない）
TURNSTILE_SECRET_KEY=（Cloudflare Turnstile のシークレットキーをここに）
